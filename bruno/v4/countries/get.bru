meta {
  name: Get country by ISO code
  type: http
  seq: 2
}

get {
  url: {{base_url}}/v4/countries/{{iso_3}}?with_geometry=true&iucn_category_long_names=false&group_governances=false
  body: none
  auth: inherit
}

params:query {
  with_geometry: true
  iucn_category_long_names: false
  group_governances: false
}

params:path {
  iso_3: {{iso_3}}
}

docs {
  Get one country by ISO3 (e.g. KEN) or ISO2 (e.g. KE) code. 404 if not found.
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the requested country", function() {
    const c = res.getBody().country;
    expect(c.iso_3).to.equal(bru.getEnvVar("iso_3"));
    expect(c).to.include.all.keys("name", "pas_count", "designations", "iucn_categories", "governances", "links");
    expect(c.pas_count).to.be.a("number");
  });
}
