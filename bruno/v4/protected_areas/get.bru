meta {
  name: Get protected area by site_id
  type: http
  seq: 4
}

get {
  url: {{base_url}}/v4/protected_areas/{{site_id}}?with_geometry=true
  body: none
  auth: inherit
}

params:query {
  with_geometry: true
}

params:path {
  site_id: {{site_id}}
}

docs {
  Get a protected area via its site_id (WDPA ID). 404 if not found.
}
