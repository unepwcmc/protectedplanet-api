meta {
  name: BIOPAMA (ACP countries)
  type: http
  seq: 3
}

get {
  url: {{base_url}}/v4/protected_areas/biopama?with_geometry=false
  body: none
  auth: inherit
}

params:query {
  with_geometry: false
}

docs {
  Get ACP countries protected areas, with PAME evaluations. Not paginated.
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a non-empty, unpaginated list", function() {
    const body = res.getBody();
    expect(body.protected_areas).to.be.an("array").that.is.not.empty;
    expect(body).to.not.have.property("pagination");
  });
}
