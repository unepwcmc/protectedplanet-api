meta {
  name: List protected areas
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v4/protected_areas?page=1&per_page=25&with_geometry=false
  body: none
  auth: inherit
}

params:query {
  page: 1
  per_page: 25
  with_geometry: false
}

docs {
  Get all protected areas, paginated. per_page must be 1..50.
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns 1..25 protected areas", function() {
    const pas = res.getBody().protected_areas;
    expect(pas).to.be.an("array").that.is.not.empty;
    expect(pas.length).to.be.at.most(25);
    pas.forEach(pa => expect(pa.site_id).to.be.a("number"));
  });

  test("has integer pagination for page 1", function() {
    const p = res.getBody().pagination;
    expect(p.page).to.equal(1);
    expect(p.per_page).to.equal(25);
    expect(p.total_pages).to.be.a("number");
    expect(p.total_count).to.be.a("number");
  });

  test("omits geojson when with_geometry=false", function() {
    expect(res.getBody().protected_areas[0]).to.not.have.property("geojson");
  });
}
