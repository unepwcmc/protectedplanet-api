meta {
  name: Search protected area parcels
  type: http
  seq: 2
}

get {
  url: {{base_url}}/v4/protected_area_parcels/search?country=KEN&page=1&per_page=25&with_geometry=false
  body: none
  auth: inherit
}

params:query {
  country: KEN
  page: 1
  per_page: 25
  with_geometry: false
  ~marine: true
  ~designation: 1
  ~jurisdiction: 1
  ~governance: 1
  ~iucn_category: 1
}

docs {
  Search for a subset of protected area parcels.
  At least one of: country, marine, designation, jurisdiction, governance, iucn_category.
}
