default: &default
  host: https://protectedplanet.net
  turnstile:
    site_key: <%= ENV["TURNSTILE_SITE_KEY"] %>
    secret_key: <%= ENV["TURNSTILE_SECRET_KEY"] %>
  mailer: &mailer
    notifications_recipients:
      - informatics@unep-wcmc.org
    subject_prefix: "Protected Planet API - "
  appsignal_api_token: <%= ENV["APPSIGNAL_API_TOKEN"] %>

development:
  <<: *default
  host: http://localhost:9292
  appsignal_api_token: <%= ENV["APPSIGNAL_API_TOKEN"] %>
  turnstile:
    <%# 3x00000000000000000000FF will make it always challange %>
    <%# Visit https://developers.cloudflare.com/turnstile/troubleshooting/testing/ to see all options %>
    site_key: <%= ENV["TURNSTILE_SITE_KEY"] || '3x00000000000000000000FF' %>
    <%# 0x0000000000000000000000000000000000000000 will make it always pass %>
    secret_key: <%= ENV["TURNSTILE_SECRET_KEY"] || '0x0000000000000000000000000000000000000000' %>
  mailer:
    <<: *mailer
    subject_prefix: "[Development] Protected Planet API - "

test:
  <<: *default
  mailer:
    <<: *mailer
    subject_prefix: "[Test] Protected Planet API - "

staging:
  <<: *default
  host: https://pp.new-web.pp-staging.linode.protectedplanet.net
  mailer:
    <<: *mailer
    notifications_recipients:
      - yue-long.he@unep-wcmc.org
    subject_prefix: "[Staging] Protected Planet API - "

production:
  <<: *default
  host: https://protectedplanet.net
  mailer:
    <<: *mailer
    notifications_recipients:
      - protectedareas@unep-wcmc.org
      - Osgur.McDermott-Long@unep-wcmc.org
      - alanah.lewis@unep-wcmc.org
    subject_prefix: "Protected Planet API - "
