# Secret NAMES only — this file is committed and must stay safe for git.
# Values come from the environment at deploy time (your shell locally, GitHub
# environment secrets in CI). The deploy workflow parses this file and fails
# listing anything unset, so a missing secret is a clear error rather than a
# container that boots and crashes.
#
# No registry credentials: the image is built on the deploy host and never
# crosses a registry. See config/deploy.yml.

# Rack
RACK_SESSION_SECRET=$RACK_SESSION_SECRET

# Database — sept19_from_production on the Proxmox staging DB host.
# Shared with ProtectedPlanet; the two cannot diverge on DB/PostGIS version.
POSTGRES_HOST=$POSTGRES_HOST
POSTGRES_PORT=$POSTGRES_PORT
POSTGRES_DBNAME=$POSTGRES_DBNAME
POSTGRES_USER=$POSTGRES_USER
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# App
CORS_ORIGINS=$CORS_ORIGINS
ADMIN_USERNAME=$ADMIN_USERNAME
ADMIN_PASSWORD=$ADMIN_PASSWORD

# Mail
MAILER_AUTHENTICATION=$MAILER_AUTHENTICATION
MAILER_ADDRESS=$MAILER_ADDRESS
MAILER_DOMAIN=$MAILER_DOMAIN
MAILER_USERNAME=$MAILER_USERNAME
MAILER_PASSWORD=$MAILER_PASSWORD
MAILER_HOST=$MAILER_HOST
MAILER_PORT=$MAILER_PORT

# Monitoring
APPSIGNAL_API_TOKEN=$APPSIGNAL_API_TOKEN

# TLS for kamal-proxy — *.internal.unep-wcmc.org wildcard.
# Source of truth: certbot on n8n.internal.unep-wcmc.org
CERTIFICATE_PEM=$CERTIFICATE_PEM
PRIVATE_KEY_PEM=$PRIVATE_KEY_PEM
