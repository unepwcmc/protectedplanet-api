<div class="fullscreen-message">
  <p class="link-with-icon fullscreen-message__header">
    <i class="fa fa-exclamation-triangle fa-2x link-with-icon__icon link-with-icon__icon--above"></i>
    Unable to submit your request
  </p>
  <% if @errors %>
    <% @errors.each do |error| %>
      <p class="fullscreen-message__body"><%= error %></p>
    <% end %>
  <% end %>
  <p class="fullscreen-message__body">
    <a class="link-with-icon link-with-icon--inherit" href="/request">Go back to the request form</a>
  </p>
</div>
